<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, API 26+. The launcher masks these two layers to whatever
     shape the device uses, and tints <monochrome> for Android 13+ themed icons.
     All three layers are generated by tool/icons/generate_icons.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
